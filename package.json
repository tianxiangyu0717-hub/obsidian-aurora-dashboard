{
  "name": "obsidian-aurora-dashboard",
  "version": "0.3.1",
  "description": "An interactive Obsidian home dashboard for tasks, knowledge graph, plugins, vault health, and writing activity.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint src",
    "test": "vitest run",
    "check": "npm run lint && npm run test && npm run build",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "dashboard",
    "statistics",
    "heatmap",
    "backlinks"
  ],
  "author": "Sean",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tianxiangyu0717-hub/obsidian-aurora-dashboard.git"
  },
  "homepage": "https://github.com/tianxiangyu0717-hub/obsidian-aurora-dashboard#readme",
  "bugs": {
    "url": "https://github.com/tianxiangyu0717-hub/obsidian-aurora-dashboard/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@types/three": "^0.185.0",
    "esbuild": "0.25.5",
    "eslint": "^10.8.0",
    "globals": "^17.6.0",
    "obsidian": "latest",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "3d-force-graph": "^1.80.0",
    "three": "^0.185.1"
  }
}
